---
import { SITE_CONFIG } from '@/config/site';
import { WHATSAPP_CONFIG } from '@/config/whatsapp';
import Button from '@/components/ui/Button.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const NAV_LINKS = [
  { label: 'Inicio', href: '/' },
  { label: 'El Problema', href: '/problema' },
  { label: 'Solución', href: '/solucion' },
  { label: 'Panel Dueño', href: '/panel' },
  { label: 'Resultados', href: '/piloto' },
  { label: 'Adaptado a Ti', href: '/como-trabajas' },
  { label: 'Precio', href: '/precios' },
  { label: 'Preguntas', href: '/faq' },
];
---

<header class="w-full bg-white border-b border-slate-200 sticky top-0 z-40 transition-all duration-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 sm:h-24 md:h-26 flex items-center justify-between gap-4 py-3">
    
    <!-- Brand identity with Large Prominent Official Logo -->
    <a href="/" class="flex items-center gap-2 group flex-shrink-0" aria-label="Cuadrape Hotel Inicio">
      <img 
        src="/logo.svg" 
        alt="Cuadrape Hotel Logo" 
        class="h-12 sm:h-16 md:h-20 w-auto transition-transform duration-200 group-hover:scale-105"
      />
    </a>

    <!-- Desktop Navigation Menu (Separated, Spaced-out, Single Line links) -->
    <nav class="hidden lg:flex items-center gap-3 xl:gap-5 flex-nowrap">
      {NAV_LINKS.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a 
            href={link.href} 
            class={`text-xs xl:text-sm font-bold px-3 py-2 rounded-xl whitespace-nowrap transition-all duration-150 ${
              isActive 
                ? 'text-brand-blue bg-blue-50/90 font-black border-b-2 border-brand-blue' 
                : 'text-slate-700 hover:text-brand-blue hover:bg-slate-100/80'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Side Actions (WhatsApp Button & Login & Mobile Hamburger) -->
    <div class="flex items-center gap-3 sm:gap-4 flex-shrink-0">
      
      <!-- Login Link -->
      <a 
        href={SITE_CONFIG.appUrl} 
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex text-xs sm:text-sm font-bold text-slate-700 hover:text-brand-blue px-3 py-2 rounded-xl hover:bg-slate-100 transition whitespace-nowrap"
      >
        Ingresar
      </a>

      <!-- Flat Official WhatsApp CTA Button -->
      <Button 
        href={WHATSAPP_CONFIG.obtenerLink()} 
        variant="whatsapp" 
        size="md" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden md:inline-flex font-bold whitespace-nowrap"
      >
        <span>Pide una demostración</span>
      </Button>

      <!-- Mobile Hamburger Menu Button -->
      <button 
        id="mobile-menu-toggle" 
        type="button" 
        class="lg:hidden p-2.5 rounded-xl text-slate-800 bg-slate-100 hover:bg-slate-200 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-7 h-7 stroke-current fill-none stroke-[2.5]" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="close-icon" class="hidden w-7 h-7 stroke-current fill-none stroke-[2.5]" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

    </div>

  </div>

  <!-- Mobile Drawer Menu Dropdown (Clean Spaced Cards) -->
  <div 
    id="mobile-menu" 
    class="hidden lg:hidden border-t border-slate-200 bg-white shadow-xl transition-all duration-300"
  >
    <div class="px-4 py-6 space-y-4 max-w-md mx-auto">
      
      <div class="text-xs font-bold uppercase tracking-wider text-slate-400 px-1">Menú Principal</div>

      <!-- Links Grid -->
      <nav class="grid grid-cols-2 gap-3 text-xs font-bold">
        {NAV_LINKS.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a 
              href={link.href} 
              class={`mobile-nav-link block p-3.5 rounded-xl border text-center whitespace-nowrap transition ${
                isActive 
                  ? 'bg-brand-blue text-white border-brand-blue font-black' 
                  : 'bg-slate-50 text-slate-800 border-slate-200 hover:border-brand-blue hover:text-brand-blue hover:bg-white'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Mobile Actions -->
      <div class="pt-4 border-t border-slate-200 space-y-3">
        <Button 
          href={WHATSAPP_CONFIG.obtenerLink()} 
          variant="whatsapp" 
          size="md" 
          fullWidth={true}
          target="_blank" 
          rel="noopener noreferrer"
          class="font-black whitespace-nowrap"
        >
          <span>Pide una demostración por WhatsApp</span>
        </Button>

        <a 
          href={SITE_CONFIG.appUrl} 
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center font-bold text-slate-800 bg-slate-100 hover:bg-slate-200 border border-slate-200 px-4 py-3 rounded-xl text-xs sm:text-sm transition whitespace-nowrap"
        >
          Acceso a Clientes (Ingresar a tu hospedaje)
        </a>
      </div>

    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

    if (!toggleBtn || !mobileMenu) return;

    function toggleMenu() {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', !isExpanded);
      
      if (isExpanded) {
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    }

    toggleBtn.addEventListener('click', toggleMenu);

    mobileNavLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (!mobileMenu.classList.contains('hidden')) {
          toggleMenu();
        }
      });
    });
  });
</script>
