---
import { PRECIOS_CONFIG } from '@/config/precios';
import { WHATSAPP_CONFIG } from '@/config/whatsapp';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import TableroDemo from '@/components/ui/TableroDemo.astro';
---

<section id="portada" class="relative pt-8 pb-16 md:pt-14 md:pb-24 bg-gradient-to-b from-white via-slate-50 to-brand-bg border-b border-slate-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto space-y-6">
      
      <!-- Top Pill Tag -->
      <div class="inline-flex items-center gap-2">
        <Badge variant="brand" size="md">
          Control presencial y a distancia para tu hospedaje
        </Badge>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-brand-blue tracking-tight leading-[1.15]">
        Sistema de control para hospedajes que alquilan por horas
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-slate-600 font-medium leading-relaxed max-w-2xl mx-auto">
        Cada ingreso, cobro y salida queda registrado a nombre de quien lo hizo, y tú lo ves en tiempo real desde tu celular.
      </p>

      <!-- Primary CTA & Pricing Badge -->
      <div class="pt-2 flex flex-col items-center gap-4">
        <Button 
          id="hero-whatsapp-btn"
          href={WHATSAPP_CONFIG.obtenerLink()} 
          variant="whatsapp" 
          size="lg" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto font-black shadow-xl"
        >
          <span>Pide una demostración por WhatsApp</span>
        </Button>

        <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs sm:text-sm text-slate-700 font-semibold">
          <span class="text-brand-blue font-bold font-numeric">{PRECIOS_CONFIG.planMensual.simbolo}{PRECIOS_CONFIG.planMensual.monto} al mes</span>
          <span class="text-slate-400">•</span>
          <span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-bold">IGV incluido</span>
          <span class="text-slate-400">•</span>
          <span class="text-slate-600">Sin permanencia</span>
        </div>
      </div>

    </div>

    <!-- Interactive Dashboard Mockup in Hero -->
    <div class="mt-10 md:mt-14">
      <TableroDemo />
    </div>

  </div>
</section>
