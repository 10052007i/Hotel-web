---
import { FAQS_HOSPEDAJES } from '@/data/hospedajes/faq';
---

<section id="faq" class="py-12 md:py-20 bg-brand-bg border-b border-slate-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <div class="text-center max-w-2xl mx-auto space-y-4">
      <span class="text-xs font-black uppercase tracking-widest text-brand-blue bg-blue-50 px-3 py-1 rounded-full border border-blue-100">
        Resuelvas tus Dudas
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-brand-blue tracking-tight">
        Preguntas Frecuentes
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        Todo lo que necesitas saber antes de solicitar tu demostración.
      </p>
    </div>

    <!-- FAQ Accordions -->
    <div class="mt-10 space-y-4">
      {FAQS_HOSPEDAJES.map((faq) => (
        <details class="group bg-white border border-slate-200 rounded-2xl p-5 shadow-sm transition hover:border-brand-blue/30 [&_svg]:open:rotate-180">
          <summary class="flex justify-between items-center font-bold text-base cursor-pointer list-none text-slate-900 select-none">
            <span>{faq.pregunta}</span>
            <span class="ml-4 transition-transform duration-200 text-brand-blue flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
            <p>{faq.respuesta}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
