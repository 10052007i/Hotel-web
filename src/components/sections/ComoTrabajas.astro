---
import { CARACTERISTICAS_TRABAJO } from '@/data/hospedajes/caracteristicas';
---

<section id="como-trabajas" class="py-12 md:py-20 bg-white border-b border-slate-200">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="text-xs font-black uppercase tracking-widest text-brand-blue bg-blue-50 px-3 py-1 rounded-full border border-blue-100">
        Adaptado a tu Operación
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-brand-blue tracking-tight">
        Hecho para cómo trabajas tú y tu equipo
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        Sin complicaciones técnicas. Diseñado exactamente para la rutina de un hospedaje peruano.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
      {CARACTERISTICAS_TRABAJO.map((item) => (
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 hover:border-brand-blue/30 transition shadow-sm space-y-2">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-brand-blue text-brand-gold flex items-center justify-center font-bold text-sm">
              ✓
            </div>
            <h3 class="font-bold text-base text-slate-900">{item.titulo}</h3>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed pl-11">
            {item.descripcion}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
