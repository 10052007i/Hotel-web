---
interface Props {
  variant?: 'brand' | 'success' | 'warning' | 'danger' | 'neutral';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'brand', size = 'md', class: className = '' } = Astro.props;

const variantStyles = {
  brand: "bg-brand-blue/10 text-brand-blue border-brand-blue/20",
  success: "bg-emerald-50 text-emerald-700 border-emerald-200",
  warning: "bg-amber-50 text-amber-700 border-amber-200",
  danger: "bg-rose-50 text-rose-700 border-rose-200",
  neutral: "bg-slate-100 text-slate-700 border-slate-200"
};

const sizeStyles = {
  sm: "px-2.5 py-0.5 text-xs font-semibold",
  md: "px-3.5 py-1 text-sm font-semibold"
};
---

<span class={`inline-flex items-center rounded-full border ${variantStyles[variant]} ${sizeStyles[size]} ${className}`}>
  <slot />
</span>
