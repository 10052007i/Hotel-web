---
// TableroDemo.astro - Simulación interactiva con fondo de código de programación 100% nítido y visible
---
<div class="w-full max-w-4xl mx-auto text-white rounded-2xl shadow-2xl border-2 border-slate-600 overflow-hidden font-sans text-left relative group">
  
  <!-- Real Web Development Code Background (High Contrast & High Opacity) -->
  <div class="absolute inset-0 bg-[url('/images/bg-code-editor.jpg')] bg-cover bg-center opacity-85 pointer-events-none"></div>
  <div class="absolute inset-0 bg-slate-950/65 pointer-events-none"></div>

  <!-- Content Container -->
  <div class="relative z-10">
    <!-- Header Bar -->
    <div class="bg-slate-950/95 px-4 py-3 border-b border-slate-800 flex flex-wrap items-center justify-between gap-2 backdrop-blur-sm">
      <div class="flex items-center gap-3">
        <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
        <span class="font-bold text-sm text-slate-200">Hospedaje Ucayali • Turno Tarde (Recepcionista: Carlos M.)</span>
      </div>
      <div class="flex items-center gap-2 text-xs text-slate-400">
        <span>Caja Actual: <strong class="text-emerald-400 font-numeric">S/ 480.00</strong></span>
        <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-numeric">15:30 PM</span>
      </div>
    </div>

    <!-- Action Bar / Notice -->
    <div class="bg-brand-blue/95 px-4 py-2 text-xs font-semibold text-sky-100 flex items-center justify-between border-b border-sky-900 shadow">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-brand-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Demostración interactiva: Haz clic en la <strong>Habitación 5</strong> para probar el bloqueo de reasignación.
      </span>
      <span class="hidden sm:inline bg-sky-950 text-brand-gold px-2 py-0.5 rounded text-[11px]">Control en Vivo</span>
    </div>

    <!-- Rooms Grid -->
    <div class="p-4 sm:p-6 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 bg-slate-950/70">
      
      <!-- Hab 1 -->
      <div class="bg-slate-900/90 border border-slate-700/80 rounded-xl p-3 flex flex-col justify-between hover:border-emerald-500/80 transition shadow-md">
        <div class="flex justify-between items-start">
          <span class="font-black text-lg text-white">Hab 01</span>
          <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-500/25 text-emerald-400 border border-emerald-500/40">Libre</span>
        </div>
        <div class="mt-3 text-xs text-slate-400">
          <div>Tarifa: <strong class="text-slate-200">S/ 30.00 / 4h</strong></div>
          <div class="text-[10px] text-slate-500 mt-1">Limpia y lista</div>
        </div>
      </div>

      <!-- Hab 2 -->
      <div class="bg-slate-900/90 border border-rose-900/80 rounded-xl p-3 flex flex-col justify-between shadow-md">
        <div class="flex justify-between items-start">
          <span class="font-black text-lg text-white">Hab 02</span>
          <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-rose-500/25 text-rose-400 border border-rose-500/40">Ocupada</span>
        </div>
        <div class="mt-2 text-xs text-slate-300">
          <div class="text-[11px] text-slate-400">Entrada: 14:00 (4h)</div>
          <div class="text-rose-400 font-bold font-numeric text-[11px] mt-0.5">Resta: 02h 30m</div>
        </div>
      </div>

      <!-- Hab 3 -->
      <div class="bg-slate-900/90 border border-slate-700/80 rounded-xl p-3 flex flex-col justify-between shadow-md">
        <div class="flex justify-between items-start">
          <span class="font-black text-lg text-white">Hab 03</span>
          <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-500/25 text-emerald-400 border border-emerald-500/40">Libre</span>
        </div>
        <div class="mt-3 text-xs text-slate-400">
          <div>Tarifa: <strong class="text-slate-200">S/ 40.00 / Noche</strong></div>
        </div>
      </div>

      <!-- Hab 4 -->
      <div class="bg-slate-900/90 border border-amber-900/80 rounded-xl p-3 flex flex-col justify-between shadow-md">
        <div class="flex justify-between items-start">
          <span class="font-black text-lg text-white">Hab 04</span>
          <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-500/25 text-amber-400 border border-amber-500/40">Limpieza</span>
        </div>
        <div class="mt-3 text-xs text-slate-400">
          <div class="text-amber-300 text-[11px]">En revisión de recepción</div>
        </div>
      </div>

      <!-- HABITACIÓN 5 - LA HABITACIÓN DEL CASO DE NEGOCIO -->
      <div id="hab5-card" class="col-span-2 sm:col-span-2 bg-slate-950/95 border-2 border-brand-gold rounded-xl p-4 shadow-xl relative overflow-hidden transition-all duration-300">
        <div class="absolute top-0 right-0 bg-brand-gold text-slate-950 text-[10px] font-extrabold px-2.5 py-0.5 rounded-bl-lg uppercase tracking-wider">
          Caso de Prueba (Hab 5)
        </div>
        <div class="flex justify-between items-start">
          <div>
            <span class="font-black text-xl text-white">Habitación 05</span>
            <p class="text-xs text-amber-300 font-medium">Alquilada a las 14:00 p.m. por 4 horas (S/ 40.00)</p>
          </div>
          <span id="hab5-status" class="px-2.5 py-1 text-xs font-bold rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30">
            Ocupada
          </span>
        </div>

        <!-- Content area depending on interaction state -->
        <div id="hab5-content-1" class="mt-3 bg-slate-900/90 p-3 rounded-lg border border-slate-700 text-xs space-y-2">
          <div class="flex justify-between items-center text-slate-300">
            <span>Tiempo pagado: <strong>4 horas</strong></span>
            <span class="text-rose-400 font-numeric font-bold">Salida pactada: 18:00</span>
          </div>
          <p class="text-slate-300 text-[11px] leading-relaxed">
            <strong>Situación a las 15:00 p.m.:</strong> Los huéspedes se retiran 3 horas antes.
          </p>
          <button id="btn-simular-liberacion" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-2 px-3 rounded-lg text-xs transition flex items-center justify-center gap-1.5 shadow-lg">
            <span>Marcar "Liberar antes de tiempo"</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </button>
        </div>

        <!-- Hidden State 2: System lock popup simulation -->
        <div id="hab5-content-2" class="hidden mt-3 bg-amber-950/80 p-3 rounded-lg border border-amber-600/50 text-xs space-y-2 animate-fadeIn">
          <div class="flex items-center gap-2 text-amber-400 font-bold">
            <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m0 0v2m0-2h2m-2 0H10m0-6h4m-2 4v-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Registro Obligatorio de Liberación</span>
          </div>
          <p class="text-slate-300 text-[11px]">
            Cuadrape <strong>impide re-alquilar la habitación 5</strong> mientras tenga tiempo pagado a menos que el recepcionista ingrese el motivo exacto de la salida anticipada.
          </p>
          <div class="bg-slate-950 p-2 rounded border border-slate-700">
            <label class="block text-[10px] text-slate-400 mb-1 font-semibold">Motivo registrado a nombre del recepcionista:</label>
            <div class="text-xs text-amber-200 font-mono italic">"Cliente se retiró temprano por viaje de emergencia"</div>
          </div>
          <button id="btn-confirmar-liberacion" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-3 rounded-lg text-xs transition flex items-center justify-center gap-1.5 shadow">
            <span>Confirmar Liberación y Enviar Alerta al Dueño</span>
          </button>
        </div>

        <!-- Hidden State 3: Final resolution -->
        <div id="hab5-content-3" class="hidden mt-3 bg-emerald-950/80 p-3 rounded-lg border border-emerald-600/50 text-xs space-y-2">
          <div class="flex items-center gap-2 text-emerald-400 font-bold">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>¡Liberación registrada a las 15:00 p.m.!</span>
          </div>
          <p class="text-emerald-200 text-[11px]">
            El dueño recibe la notificación en su celular. La Habitación 5 ahora puede volver a alquilarse a las 15:30 p.m. <strong>registrando el nuevo ingreso a caja sin pérdidas invisibles.</strong>
          </p>
          <button id="btn-reiniciar-demo" class="text-xs text-slate-400 underline hover:text-white mt-1">
            Reiniciar demostración
          </button>
        </div>

      </div>

      <!-- Hab 6 -->
      <div class="bg-slate-900/90 border border-slate-700/80 rounded-xl p-3 flex flex-col justify-between shadow-md">
        <div class="flex justify-between items-start">
          <span class="font-black text-lg text-white">Hab 06</span>
          <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-500/25 text-emerald-400 border border-emerald-500/40">Libre</span>
        </div>
        <div class="mt-3 text-xs text-slate-400">
          <div>Tarifa: <strong class="text-slate-200">S/ 35.00 / 4h</strong></div>
        </div>
      </div>

      <!-- Hab 7 -->
      <div class="bg-slate-900/90 border border-rose-900/80 rounded-xl p-3 flex flex-col justify-between shadow-md">
        <div class="flex justify-between items-start">
          <span class="font-black text-lg text-white">Hab 07</span>
          <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-rose-500/25 text-rose-400 border border-rose-500/40">Ocupada</span>
        </div>
        <div class="mt-2 text-xs text-slate-300">
          <div class="text-[11px] text-slate-400">Noche • Pago Yape</div>
          <div class="text-rose-400 font-bold font-numeric text-[11px] mt-0.5">Op: #98342</div>
        </div>
      </div>

    </div>

    <!-- Bottom alert indicator -->
    <div class="bg-slate-950/95 p-3 text-xs text-slate-300 border-t border-slate-800 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
        <span>Alerta Celular Dueño: <strong>1 liberación anticipada auditada</strong></span>
      </div>
      <span class="text-[11px] text-slate-400">Cuadrape Web v1.0</span>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btnSimular = document.getElementById('btn-simular-liberacion');
    const btnConfirmar = document.getElementById('btn-confirmar-liberacion');
    const btnReiniciar = document.getElementById('btn-reiniciar-demo');

    const content1 = document.getElementById('hab5-content-1');
    const content2 = document.getElementById('hab5-content-2');
    const content3 = document.getElementById('hab5-content-3');

    const hab5Status = document.getElementById('hab5-status');

    if (btnSimular) {
      btnSimular.addEventListener('click', () => {
        content1.classList.add('hidden');
        content2.classList.remove('hidden');
        hab5Status.textContent = 'En Liberación';
        hab5Status.className = 'px-2.5 py-1 text-xs font-bold rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/30';
      });
    }

    if (btnConfirmar) {
      btnConfirmar.addEventListener('click', () => {
        content2.classList.add('hidden');
        content3.classList.remove('hidden');
        hab5Status.textContent = 'Liberada Auditoría';
        hab5Status.className = 'px-2.5 py-1 text-xs font-bold rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
      });
    }

    if (btnReiniciar) {
      btnReiniciar.addEventListener('click', () => {
        content3.classList.add('hidden');
        content1.classList.remove('hidden');
        hab5Status.textContent = 'Ocupada';
        hab5Status.className = 'px-2.5 py-1 text-xs font-bold rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30';
      });
    }
  });
</script>
