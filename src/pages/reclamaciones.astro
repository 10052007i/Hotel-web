---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import { SITE_CONFIG } from '@/config/site';
---

<BaseLayout title={`Libro de Reclamaciones | ${SITE_CONFIG.nombreEmpresa}`} description="Libro de reclamaciones virtual.">
  <Header />
  <main class="max-w-3xl mx-auto px-4 py-12 sm:py-16 space-y-6">
    <div class="border-b pb-4">
      <h1 class="text-3xl font-black text-brand-blue">Libro de Reclamaciones Virtual</h1>
      <p class="text-sm text-slate-600 font-numeric mt-1">{SITE_CONFIG.nombreEmpresa} • RUC {SITE_CONFIG.ruc}</p>
    </div>

    <form class="space-y-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-sm">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Nombre Completo</label>
          <input type="text" class="w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-blue outline-none" required placeholder="Tu nombre" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">DNI / RUC</label>
          <input type="text" class="w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-blue outline-none font-numeric" required placeholder="Número de documento" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Correo Electrónico</label>
          <input type="email" class="w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-blue outline-none" required placeholder="correo@ejemplo.com" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Teléfono</label>
          <input type="tel" class="w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-blue outline-none font-numeric" required placeholder="961000000" />
        </div>
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Detalle del Reclamo o Queja</label>
        <textarea rows="4" class="w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-blue outline-none" required placeholder="Escribe el detalle de tu reclamo o sugerencia..."></textarea>
      </div>

      <button type="submit" class="w-full bg-brand-blue text-white font-bold py-3 rounded-xl hover:bg-slate-800 transition">
        Enviar Registro al Libro de Reclamaciones
      </button>
    </form>
  </main>
  <Footer />
</BaseLayout>
