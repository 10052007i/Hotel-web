---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Problema from '@/components/sections/Problema.astro';
import Footer from '@/components/sections/Footer.astro';
import WhatsAppFijo from '@/components/ui/WhatsAppFijo.astro';
---

<BaseLayout 
  title="El Problema en Hospedajes | Cuadrape Web"
  description="Una habitación, dos cobros, una sola entrada a caja. Conoce cómo se producen las fugas de dinero no registradas en cuadernos."
>
  <Header currentPath="/problema" />
  <main class="flex-grow">
    <div class="bg-brand-blue text-white py-10 px-4 text-center">
      <div class="max-w-4xl mx-auto space-y-2">
        <h1 class="text-3xl sm:text-4xl font-black">El Problema de la Caja en Hospedajes</h1>
        <p class="text-sm sm:text-base text-sky-100 max-w-2xl mx-auto">
          Por qué el cuaderno o registro manual genera pérdidas invisibles difíciles de auditar.
        </p>
      </div>
    </div>
    <Problema />
  </main>
  <Footer />
  <WhatsAppFijo idTriggerPortada="hero-whatsapp-btn" />
</BaseLayout>
